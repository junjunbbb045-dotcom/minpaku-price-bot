# config/cloudflare.env としてコピーし、値を埋める（このファイルは git 管理外）
# Account ID: Cloudflare ダッシュボード「Workers & Pages」右側に表示
CLOUDFLARE_ACCOUNT_ID=
# API Token: My Profile > API Tokens > Create Custom Token（Account / Cloudflare Pages / Edit）
CLOUDFLARE_API_TOKEN=
# Pages のプロジェクト名（省略時 minpaku-dashboard）。公開URLは https://<プロジェクト名>.pages.dev
CLOUDFLARE_PAGES_PROJECT=minpaku-dashboard
